# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me

# App database connection (docker compose sets DATABASE_URL itself).
DATABASE_USERNAME=factory
DATABASE_PASSWORD=change-me

# Factory behaviour
FACTORY_INTEGRATIONS=fake
FACTORY_REPO=example-org/example-repo
FACTORY_TRIGGER_LABEL=factory
FACTORY_MAX_COST_USD=2.00
FACTORY_MAX_TURNS=40
FACTORY_HARD_TIMEOUT=PT30M
FACTORY_MAX_RETRIES=3

# Spring profile. "demo" seeds ~20 fake tickets on first start.
SPRING_PROFILES_ACTIVE=demo

# Real GitHub (only used with FACTORY_INTEGRATIONS=real). Pick ONE of:
#  a) GitHub App (recommended): narrow permissions, tokens expire after an hour
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
#  b) Fine-grained personal access token (issues, pull requests: read/write; contents: read)
# GITHUB_TOKEN=
# Who may trigger the factory by labeling an issue: read | write | admin (default write)
# FACTORY_MIN_LABELER_PERMISSION=write

# Docker sandbox (real mode). Build the image first: docker build -t factory-sandbox:latest sandbox
# (git, a shell, Python and the Claude Code CLI; add your repo's toolchain to sandbox/Dockerfile).
# FACTORY_SANDBOX_IMAGE=factory-sandbox:latest
# FACTORY_SANDBOX_MEMORY=4g
# FACTORY_SANDBOX_CPUS=2.0
# FACTORY_WORK_DIR=/var/lib/factory

# Checks (real mode). Each target repo names its command in .factory.yml on the base branch; these are fallbacks.
# FACTORY_CHECKS_DEFAULT_COMMAND=
# FACTORY_CHECKS_DEFAULT_TIMEOUT=PT10M
# FACTORY_CHECKS_MAX_TIMEOUT=PT30M

# Claude Code agent (real mode). Set ONE. It stays on this host and in the per-ticket model proxy; sandboxes only get
# a placeholder, so the agent and the code it runs can never read it.
#  a) API key (recommended for teams and pilots; set a spending limit in the Anthropic console)
# ANTHROPIC_API_KEY=
#  b) Claude Pro/Max subscription token from `claude setup-token` (personal use; counts against your plan's limits)
# CLAUDE_CODE_OAUTH_TOKEN=
# Optional: model for the agent (default: the CLI's default), and the tools it may use
# FACTORY_AGENT_MODEL=
# FACTORY_AGENT_TOOLS=Bash,Read,Edit,Write
