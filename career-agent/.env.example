# Copy to .env (git-ignored) and fill in. Secrets live here and in n8n's encrypted credential store,
# never inside workflow nodes.
POSTGRES_ADMIN_USER=career_admin
POSTGRES_ADMIN_PASSWORD=change-me-long-random
CAREER_DB_PASSWORD=change-me-too            # password of the least-privilege 'career_app' role used by workflows
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
ANTHROPIC_API_KEY=sk-ant-...                # Console > API keys. Set a monthly spend limit on it.
# Module C (Gmail): OAuth client from Google Cloud Console (see docs/module-c.md §2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional (alerts, Module H)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only needed later, when Telegram approval buttons need a public HTTPS webhook
N8N_HOST=localhost
N8N_WEBHOOK_URL=
